  "driverSource": "import { it, expect } from 'vitest';\nimport { performance } from 'node:perf_hooks';\nimport { writeFileSync } from 'node:fs';\nimport { cpus, platform, arch } from 'node:os';\nimport { schoolSnapshot } from '/workspace/msgsud-bale-programi/tests/fixtures/m43/snapshots';\nimport { createManagementWorkspaceWorkingCopyV1 } from '@/lib/managementWorkspaceWorkingCopy';\nimport { buildManagementWorkspacePrevalidatedMoveCandidateDetailsV1 as before } from './acceptedCandidates';\nimport { buildManagementWorkspacePrevalidatedMoveCandidateDetailsV1 as after } from '@/lib/managementWorkspaceCandidates';\n\nit('compares the accepted 24101f6 drag pipeline with active local requirement validation', () => {\n  const rows = [];\n  const stats = (values: number[]) => {\n    const sorted = [...values].sort((a, b) => a - b);\n    return { medianMs: sorted[Math.floor(sorted.length / 2)], p95Ms: sorted[Math.ceil(sorted.length * 0.95) - 1] };\n  };\n  for (const scenario of ['single', 'multi-period', 'parallel', 'dense-slot']) {\n    const source = schoolSnapshot(517);\n    if (scenario === 'multi-period') source.cards[0].durationPeriods = 2;\n    if (scenario === 'parallel') {\n      source.requirements[0].groupName = 'PARALLEL \u2022 Combined / 1';\n      source.requirements[1].groupName = 'PARALLEL \u2022 Combined / 2';\n    }\n    if (scenario === 'dense-slot') source.baselinePlacements.slice(0, 80).forEach(p => { p.dayOfWeek = 1; p.startPeriod = 1; });\n    const copy = createManagementWorkspaceWorkingCopyV1(source);\n    const ids = scenario === 'parallel' ? ['c0', 'c1'] : ['c0'];\n    const run = (fn: typeof after) => fn(source, copy, ids, {}, 5);\n    expect(run(after)).toStrictEqual(run(before));\n    for (let i = 0; i < 10; i++) { run(before); run(after); }\n    const b: number[] = [], a: number[] = [];\n    const measure = (fn: typeof after, samples: number[]) => {\n      const t = performance.now(); run(fn); samples.push(performance.now() - t);\n    };\n    for (let i = 0; i < 50; i++) {\n      if (i % 2) { measure(after, a); measure(before, b); }\n      else { measure(before, b); measure(after, a); }\n    }\n    rows.push({ scenario, before: stats(b), after: stats(a), samplesBeforeMs: b, samplesAfterMs: a });\n  }\n  const report = {\n    baselineCommit: '24101f6e96914a32097965a4e1cb6f498244536a',\n    environment: { node: process.version, platform: platform(), arch: arch(), cpu: cpus()[0].model, logicalCpus: cpus().length, canonicalAWS: false, browser: false },\n    fixture: 'M43 schoolSnapshot(517), synthetic, not production data', activeDay: 5, evaluatedPeriods: 12,\n    methodology: 'Accepted validation/commands/candidates exported with git show; only their mutual imports redirected. Other runtime modules unchanged. Same process, identical inputs, alternating order; 10 warmups, 50 samples per implementation; external complete candidate pipeline timing, profiling off.',\n    rows,\n  };\n  writeFileSync('/workspace/partisyon-overnight-benchmark/active-requirement-benchmark.json', JSON.stringify(report, null, 2) + '\\n');\n  console.info(JSON.stringify({ environment: report.environment, rows: rows.map(({ samplesBeforeMs, samplesAfterMs, ...row }) => row) }, null, 2));\n}, 120000);\n",
